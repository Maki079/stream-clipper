# Copy this file to .env beside docker-compose.yml.
# Docker Compose reads .env and passes these values to the web panel.
# Leave both empty for localhost / SSH tunnel access without a login.

# Set a strong password to enable login (username: admin).
# Single quotes keep special characters such as $ literal in Compose .env files.
# Example: CLIPPER_WEB_PASSWORD='replace-with-your-own-strong-password'
CLIPPER_WEB_PASSWORD=

# Allowed browser hostnames, IP addresses, wildcard domains, or CIDR networks.
# Separate entries with commas. No http://, https://, ports, or URL paths.
# A nonempty host list REQUIRES CLIPPER_WEB_PASSWORD to be set.
# Example: CLIPPER_WEB_HOSTS=clipper.example.com,*.example.com,192.168.1.0/24,fd00::/8
# *.example.com matches subdomains at any depth, but NOT example.com itself.
# Add example.com separately if needed. Bare * and other glob patterns are invalid.
# CIDR entries match literal IPs in the HTTP Host header, NOT client source IPs.
# DNS names are not resolved for CIDR matching. Use a firewall for client IP rules.
# localhost, 127.0.0.1, and ::1 are always allowed.
CLIPPER_WEB_HOSTS=

# Hostnames alone do not expose the panel to the network. The default Compose
# port mapping is 127.0.0.1:8080:8080. For direct remote access, change it to
# 8080:8080 or an intended interface, and use HTTPS through a reverse proxy.
# After editing .env: docker compose up -d
# See README.md: "Configure .env" under remote access.
